# Copy this file to .env and fill in your keys
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional: free key from tavily.com. Without it, research still works from Gemini alone.
TAVILY_API_KEY=
PORT=4002
# MOCK=true returns fixed demo data instantly (use this to unblock your teammates)
MOCK=false